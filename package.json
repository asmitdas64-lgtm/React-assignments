{
  "name": "react-assignments-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo containing Photo Gallery and Chat App assignments",
  "scripts": {
    "gallery": "npm --prefix photo-gallary/client run dev",
    "gallery:install": "npm --prefix photo-gallary/client install --legacy-peer-deps",
    "gallery:dev": "npm --prefix photo-gallary/client run dev",
    "gallery:test": "npm --prefix photo-gallary/client test",
    "gallery:build": "npm --prefix photo-gallary/client run build",
    "gallery:lint": "npm --prefix photo-gallary/client run lint",
    "chat": "npm --prefix chat-app run dev",
    "chat:install": "npm --prefix chat-app install && npm --prefix chat-app/client install --legacy-peer-deps && npm --prefix chat-app/server install",
    "chat:dev": "npm --prefix chat-app run dev",
    "chat:test": "npm --prefix chat-app test"
  }
}
